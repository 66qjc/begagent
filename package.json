{
  "name": "career-agent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm -r --if-present build",
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @career/api dev\" \"pnpm --filter @career/web dev\"",
    "start": "concurrently -n api,web -c blue,green \"pnpm --filter @career/api start\" \"pnpm --filter @career/web preview\"",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@career/contracts": "workspace:*",
    "@career/core": "workspace:*",
    "@career/infrastructure": "workspace:*",
    "@career/api": "workspace:*",
    "@career/web": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "concurrently": "9.2.1",
    "tsx": "4.20.5",
    "tinyglobby": "0.2.15",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
